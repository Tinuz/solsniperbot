# ─────────────────────────────────────────────────────────────────────────────
# Sol Sniper configuration. Copy to .env and edit.
# Every value below is the default unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Connectivity ────────────────────────────────────────────────────────────
# REQUIRED. A paid, low-latency RPC (Helius, Triton, QuickNode, ...). Public
# RPCs rate-limit and are far too slow to snipe with.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Derived from RPC_URL (https -> wss) when unset.
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Extra RPCs that also receive every signed transaction (comma separated).
# SEND_RPC_URLS=

# Optional Yellowstone gRPC (Triton, Helius LaserStream, ...). Faster and more
# reliable than websockets; used automatically when set (FEED=auto).
# GRPC_URL=https://your-grpc-endpoint:443
# GRPC_TOKEN=
# Shred-level detection: see launches before they execute (provider must support it).
# GRPC_DESHRED=false
# FEED=auto            # auto | ws | grpc

# ── Wallet ──────────────────────────────────────────────────────────────────
# Use a dedicated hot wallet holding only what you are willing to lose.
# PRIVATE_KEY=base58-secret-key-or-[json,byte,array]
# KEYPAIR_PATH=./trading-wallet.json

# ── Mode ────────────────────────────────────────────────────────────────────
# Paper trading is the default. Fills are simulated against the live curve
# after PAPER_LATENCY_MS, so paper results include realistic slippage.
DRY_RUN=true
PAPER_LATENCY_MS=350
# Paper mode + wallet: run every would-be trade through simulateTransaction to
# verify the encoding against the real program and measure compute units.
SIMULATE_DRY_RUN=false

# ── Transaction landing ─────────────────────────────────────────────────────
# auto -> helius when RPC_URL is Helius, otherwise jito. rpc = plain RPC only.
LANDING=auto
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# true = SWQoS-only tier (min tip 0.000005 SOL instead of 0.001).
HELIUS_SWQOS_ONLY=false
# JITO_BLOCK_ENGINE_URLS=https://mainnet.block-engine.jito.wtf
# JITO_AUTH_UUID=
TIP_SOL=0.001
# SELL_TIP_SOL=0.001            # defaults to TIP_SOL
# Priority fee as total SOL per transaction (converted to a CU price).
PRIORITY_FEE_MODE=fixed          # fixed | dynamic
PRIORITY_FEE_SOL=0.0005
SELL_PRIORITY_FEE_SOL=0.0003
# dynamic mode: percentile of recent pump fees, floored at PRIORITY_FEE_SOL.
PRIORITY_FEE_MAX_SOL=0.005
PRIORITY_FEE_PERCENTILE=75
# Tight compute limits raise your effective priority. Measure with SIMULATE_DRY_RUN.
BUY_COMPUTE_UNITS=180000
SELL_COMPUTE_UNITS=150000
REBROADCAST_INTERVAL_MS=400
REBROADCAST_MAX=8

# ── Entry ───────────────────────────────────────────────────────────────────
BUY_SOL=0.05
BUY_SLIPPAGE_BPS=2000            # 20%
# instant = buy the launch the moment it is seen
# momentum = wait for real buyers before entering (fewer instant rugs)
ENTRY_MODE=instant
MOMENTUM_MIN_AGE_MS=1500
MOMENTUM_MAX_AGE_MS=15000
MOMENTUM_MIN_BUYERS=6
MOMENTUM_MIN_NET_BUY_SOL=2
MOMENTUM_MAX_SELL_RATIO=0.4
# Insider filters (momentum only, 0 = off). Coins where insiders bought big in
# the first 0.5s (bundled with the launch), or where one wallet (the dev aside)
# holds a large share, are usually dumped on the buyers that follow.
MOMENTUM_MAX_EARLY_BUY_SOL=0     # skip if non-dev wallets bought more than this in the first 0.5s
MOMENTUM_MAX_TOP_BUYER_PCT=0     # skip if one wallet (dev aside) holds more than this % of supply
# Smart money (momentum only, 0 = off): wait until at least this many wallets
# whose early buys keep turning into runners have bought. The bot learns them
# from its recordings (data/wallets/), so this needs a few days of data.
MOMENTUM_MIN_SMART_BUYERS=0

# ── Launch filters ──────────────────────────────────────────────────────────
ALLOW_MAYHEM=false
ALLOW_HOLDER_REWARD=true
REQUIRE_URI=true
# Case-insensitive regexes matched against "name symbol".
# NAME_BLOCKLIST=rug|scam|test
# NAME_ALLOWLIST=
DEV_BUY_MIN_SOL=0
DEV_BUY_MAX_SOL=5
DEV_MAX_SUPPLY_PCT=15
MAX_ENTRY_MCAP_SOL=80
MAX_CURVE_PROGRESS_PCT=35
# Dev wallets launching more than N coins inside the window are skipped.
CREATOR_MAX_LAUNCHES=2
CREATOR_WINDOW_MINUTES=1440
# CREATOR_BLOCKLIST=wallet1,wallet2
# CREATOR_ALLOWLIST=wallet3
CREATOR_ALLOWLIST_ONLY=false
# Fetch metadata and require a twitter/telegram/website (adds latency).
REQUIRE_SOCIALS=false
METADATA_TIMEOUT_MS=800

# ── Exits ───────────────────────────────────────────────────────────────────
# gain%:sell% tiers on the remaining position; the last tier sells everything.
TAKE_PROFIT=60:50,150:100
STOP_LOSS_PCT=25
TRAILING_STOP_PCT=20             # 0 disables
TRAILING_ARM_PCT=30              # trailing stop activates after this gain
MAX_HOLD_SECONDS=180
STALE_SECONDS=45                 # exit when nobody has traded for this long
EXIT_ON_DEV_SELL=true
# Moonbag (free ride). Once selling all but MOONBAG_PCT% of the bought tokens
# brings back the stake, every fee (the moonbag's own sale included) and
# MOONBAG_SECURE_PCT% profit, the bot sells that and lets the rest ride on its
# own rules: sold back at entry + MOONBAG_STOP_BUFFER_PCT (+ the sell's fee),
# MOONBAG_TRAILING_PCT off its peak, when the dev sells, or at graduation.
# MAX_HOLD_SECONDS, STALE_SECONDS and take-profit tiers no longer apply: no time
# limit, it rides as long as the coin runs. Moonbags don't count against
# MAX_OPEN_POSITIONS; at most MAX_MOONBAGS ride at once.
MOONBAG_PCT=0                    # 0 = off; e.g. 25
MOONBAG_SECURE_PCT=10            # profit secured before the moonbag rides, % of the stake
MOONBAG_STOP_BUFFER_PCT=5
MOONBAG_TRAILING_PCT=40          # 0 = only the break-even stop
MOONBAG_STALE_SECONDS=1800       # a coin nobody traded for this long is dead, not a runner (0 = off)
MOONBAG_MAX_HOLD_SECONDS=0       # optional hard limit from opening; 0 = none
MAX_MOONBAGS=10
SELL_SLIPPAGE_BPS=2500
SELL_MAX_SLIPPAGE_BPS=6000       # retries widen slippage up to this
SELL_RETRIES=3
CLOSE_TOKEN_ACCOUNT=true         # reclaim ~0.002 SOL rent on full exits

# ── Survival ────────────────────────────────────────────────────────────────
# The bot keeps itself solvent: it sizes trades to its bankroll, never spends
# MIN_SOL_RESERVE (kept for exit fees), refuses trades that fees would eat,
# and shuts itself down (exit code 3) once it can no longer fund a viable
# trade and has nothing left to sell. Paper mode uses a simulated wallet.
PAPER_START_SOL=1
PAPER_RESET=false                # true = start a fresh paper wallet (revives a dead paper bot)
SIZING=fixed                     # fixed = BUY_SOL per trade | fraction = % of free balance, capped at BUY_SOL
BUY_FRACTION_PCT=5
MIN_BUY_SOL=0.02
MAX_FEE_DRAG_PCT=10              # skip trades whose round-trip tips+fees exceed this % of the size
DEFENSIVE_DRAWDOWN_PCT=30        # halve trade size this far below peak equity (0 disables)
SURVIVAL_SHUTDOWN=true           # false = stay running (buying disabled) instead of exiting

# ── Learning data ───────────────────────────────────────────────────────────
# Record every launch (bought or not) with its features and trades to
# data/launches/<day>.jsonl for `npm run analyze`, `npm run backtest` and
# `npm run research`.
RECORD_LAUNCHES=true
RECORD_HORIZON_MIN=15            # keep above MAX_HOLD_SECONDS so exits play out
RECORD_MAX_TRADES=800            # kept in full; after that a thinned price path (1/s, every 2% move, dev trades)

# ── Autotune ────────────────────────────────────────────────────────────────
# Searches the recorded launches for nearby filter/exit settings that beat the
# current ones, and accepts only candidates that also win on the newest
# launches the search never saw. Trade size, fees, reserve and risk limits are
# never touched. Tuned values live in data/tuning and are dropped when you
# change .env.
#   auto    = paper when DRY_RUN=true, suggest when live, off without recording
#   paper   = adopt automatically, then probation: rolled back if the new
#             settings do worse on launches after adoption (paper mode only)
#   suggest = propose only (dashboard + data/tuning/report.md); you decide
#   live    = live trading only, never chosen by auto: a candidate is first
#             shadow-tested on new launches without trading it, then adopted
#             at LIVE_PROBATION_SIZE_PCT of the normal size until its
#             probation passes; one setting at a time; needs REQUIRE_EDGE
#   off
# While the bot is only observing (no proven edge yet, paper or suggest), each
# cycle also explores the whole bounded range for a strategy that holds up on
# data it never saw, like `npm run research`, and adopts (paper) or suggests it.
AUTOTUNE=auto
AUTOTUNE_INTERVAL_HOURS=6
AUTOTUNE_DAYS=7                  # most recent days of recordings to learn from
AUTOTUNE_MAX_LAUNCHES=30000      # more are sampled evenly over the period (~5-10 MB RAM per 1000)
AUTOTUNE_MIN_LAUNCHES=2000       # no tuning before this much data…
AUTOTUNE_MIN_HOURS=24            # …spanning at least this long
AUTOTUNE_MIN_TRADES=60           # simulated trades needed in the search part (test part: 40%)
AUTOTUNE_MIN_EDGE_PCT=1          # required test gain per trade, as % of BUY_SOL
AUTOTUNE_MAX_CHANGES=3           # most settings one adoption may change
AUTOTUNE_PROBATION_TRADES=30     # simulated trades after adoption before it is kept
AUTOTUNE_COOLDOWN_HOURS=24       # pause after a rollback or a manual revert

# ── Prove it first ──────────────────────────────────────────────────────────
# Only buy while the settings in effect make money on the newest recorded
# launches (checked hourly, same gates and window as autotune). Until then
# the bot watches and records, which is how it learns, without spending.
#   auto = on whenever RECORD_LAUNCHES=true | true | false (trade regardless)
REQUIRE_EDGE=auto
LIVE_PROBATION_SIZE_PCT=50       # AUTOTUNE=live: trade size while new settings are on probation

# ── Cost of existence ───────────────────────────────────────────────────────
# What running the bot costs you per month (RPC plan, server). It is converted
# to SOL (CoinGecko price) and accrued while the bot runs; the dashboard shows
# the result after costs, and the edge gate only lets the bot trade when the
# recent profit also covers these costs. 0 = not counted.
OPERATING_COST_PER_MONTH=0
OPERATING_COST_CURRENCY=usd      # usd | eur | sol

# ── Risk ────────────────────────────────────────────────────────────────────
MAX_OPEN_POSITIONS=3
MAX_BUYS_PER_MINUTE=6
DAILY_LOSS_LIMIT_SOL=0           # 0 disables; pauses buying for the UTC day
MIN_SOL_RESERVE=0.02             # never spent on buys: pays for exits

# ── Notifications ───────────────────────────────────────────────────────────
# Telegram (in Dutch): starts/stops, trading enabled or paused, adoptions,
# rollbacks, vitals changes, death, feed outages, a digest every few hours, a
# daily summary, and highlights. The bot also answers commands from this chat.
# Set the token from @BotFather, message your bot once, then run
# `npm run telegram` to find your chat id and send a test message.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Who may give commands. Not needed in a private chat (its user is the owner);
# in a group, commands only count from these user ids (comma-separated).
# TELEGRAM_OWNER_IDS=
NOTIFY_TRADES=false              # also report every closed trade
NOTIFY_DAILY_HOUR_UTC=7          # daily summary at this UTC hour (-1 = off)
NOTIFY_DIGEST_HOURS=6            # digest every N hours on the local clock (00, 06, 12, 18); 0 = off
NOTIFY_HIGHLIGHTS=true           # free rides, runners at 3x/5x/10x..., new equity records
NOTIFY_COMMANDS=true             # answer /status, /vandaag, /posities, /pauze, /hervat, /verkoopalles
NOTIFY_TIMEZONE=Europe/Amsterdam # for "today" and the digest clock

# ── Dashboard / API ─────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8787
# Required (16+ characters, e.g. `openssl rand -hex 24`) for any API_HOST other
# than localhost: the bot refuses to start without it. Open the dashboard once
# with ?token=...; on a VPS an SSH tunnel to 127.0.0.1 is the safer choice.
# API_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info
