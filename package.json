{
  "name": "solsniperbot",
  "version": "2.0.0",
  "description": "Low-latency pump.fun memecoin sniper for Solana: log-stream detection, locally built transactions, multi-path landing and automated exits.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tinuz/solsniperbot.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "supervise": "npm run build && node dist/supervisor.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "analyze": "tsx scripts/analyze.ts",
    "backtest": "tsx scripts/backtest.ts",
    "research": "tsx scripts/research.ts",
    "forward": "tsx scripts/forward.ts",
    "telegram": "tsx scripts/telegram.ts"
  },
  "dependencies": {
    "@pump-fun/pump-swap-sdk": "^1.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.11.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@triton-one/yellowstone-grpc": "^7.0.1"
  }
}
